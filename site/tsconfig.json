{
  // the site's build (eleventy.config.ts and lib/) and its tests, which Node
  // runs as they are, their types stripped. The page's script
  // (src/assets/site.js) is plain JavaScript, served as it is
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["eleventy.config.ts", "*.test.ts", "lib/**/*.ts"]
}
